{
	"name": "scrapminer",
	"version": "1.0.0",
	"module": "src/index.ts",
	"type": "module",
	"description": "Automated SCRAP Token Claimer",
	"scripts": {
		"start": "bun src/index.ts start",
		"start:once": "bun src/index.ts once",
		"start:config": "bun src/index.ts config",
		"build": "bun build src/index.ts --compile --minify --outfile dist/scrapminer",
		"dev": "bun --hot src/index.ts start",
		"dev:once": "bun --hot src/index.ts once",
		"test": "bun test",
		"test:unit": "bun test test/utils.test.ts test/rootconfig.test.ts test/config.test.ts",
		"test:integration": "bun test test/websocket.test.ts test/claimer.test.ts",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"overrides": {
		"@wharfkit/antelope": "^1.0.7"
	},
	"dependencies": {
		"@wharfkit/antelope": "^1.0.7",
		"@wharfkit/contract": "^1.1.5",
		"@wharfkit/roborovski": "^1.0.0",
		"@wharfkit/session": "^1.2.8",
		"@wharfkit/wallet-plugin-privatekey": "^1.1.0",
		"commander": "^14.0.2",
		"toad-scheduler": "^3.0.0",
		"winston": "^3.11.0"
	},
	"devDependencies": {
		"@types/bun": "^1.0.8"
	}
}
