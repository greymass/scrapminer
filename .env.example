# Chain Configuration
# Chain to connect to (EOS mainnet for production)
CHAIN_NAME=EOS
# Optional: Override chain API
LEAP_API=https://eos.greymass.com
# Drops contract account
CONTRACT_NAME=drops
# SCRAP token contract
SCRAP_CONTRACT=scrap

# SCRAP API Configuration
# SCRAP API websocket endpoint (production)
SCRAP_API_URL=wss://scrap-api.greymass.com
# For local development: ws://localhost:3000

# Sync Configuration (fetches droplets from API into cache)
# Sync interval (ms) - 1 hour default
SYNC_INTERVAL=3600000
# Sync immediately on startup
SYNC_ON_STARTUP=true
# Websocket wait time per account (ms) - 30sec default
SYNC_TIMEOUT=30000

# Claim Configuration (processes droplets from cache)
# MUST be set to 'true' to broadcast transactions (safety flag)
CLAIM_ENABLED=false
# Claim check interval (ms) - 1 minute default
CLAIM_INTERVAL=60000
# Max droplets per claim transaction (default: 2500)
CLAIM_BATCH_SIZE=2500
# Automatically claim multiple batches if droplets > batch size
AUTO_RECLAIM=true
# Automatically regenerate droplets after destroying (maintains balance)
AUTO_GENERATE=false
# Delay between batches (ms) - 5sec default
BATCH_DELAY=5000

# Account Configuration
# Only private key is required - account name and permission are discovered automatically
# The system will query the blockchain to find ALL accounts/permissions the key controls
# Filters to only "claim" permissions - will claim for ALL discovered accounts
# Example: If key controls gm@claim and jesta.x@claim, both will be claimed for
# Private key (WIF format)
PRIVATE_KEY=5K...

# Logging Configuration
# debug | info | warn | error
LOG_LEVEL=info
# Logs are written to ./logs/scrapminer.log and ./logs/error.log
