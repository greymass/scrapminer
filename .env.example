# Chain Configuration
CHAIN_NAME=EOS                                  # Chain to connect to (EOS mainnet for production)
LEAP_API=https://eos.greymass.com               # Optional: Override chain API
CONTRACT_NAME=drops                             # Drops contract account
SCRAP_CONTRACT=scrap                            # SCRAP token contract

# SCRAP API Configuration  
SCRAP_API_URL=wss://scrap-api.greymass.com      # SCRAP API websocket endpoint (production)
# For local development: ws://localhost:3000

# Sync Configuration (fetches droplets from API into cache)
SYNC_INTERVAL=3600000                           # Sync interval (ms) - 1 hour default
SYNC_ON_STARTUP=true                            # Sync immediately on startup
SYNC_TIMEOUT=30000                              # Websocket wait time per account (ms) - 30sec default

# Claim Configuration (processes droplets from cache)
CLAIM_ENABLED=false                             # MUST be set to 'true' to broadcast transactions (safety flag)
CLAIM_INTERVAL=60000                            # Claim check interval (ms) - 1 minute default
CLAIM_BATCH_SIZE=2500                           # Max droplets per claim transaction (default: 2500)
AUTO_RECLAIM=true                               # Automatically claim multiple batches if droplets > batch size
AUTO_GENERATE=false                             # Automatically regenerate droplets after destroying (maintains balance)
BATCH_DELAY=5000                                # Delay between batches (ms) - 5sec default

# Account Configuration
# Only private key is required - account name and permission are discovered automatically
# The system will query the blockchain to find which account/permission the key controls
# Prefers "claim" permission if available, otherwise uses first discovered permission

PRIVATE_KEY=5K...                               # Private key (WIF format)

# Logging Configuration
LOG_LEVEL=info                                  # debug | info | warn | error
